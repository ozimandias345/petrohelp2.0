# Copia este archivo como .env (en esta misma carpeta) y llena tus datos.
# El archivo .env NO se sube a GitHub.

DJANGO_SECRET_KEY=pon-aqui-una-llave-larga-y-secreta
DJANGO_DEBUG=True

DB_NAME=dbpetro
DB_USER=postgres
DB_PASSWORD=tu-contrasena-de-postgres
DB_HOST=localhost
DB_PORT=5432

# ---- Correo para los codigos de recuperacion ----
# Usa una "contrasena de aplicacion" de Gmail, no la de tu cuenta.
# Si los dejas vacios, el codigo se imprime en la terminal en vez de enviarse.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=PetroHelp <tu-correo@gmail.com>
CODIGO_VIGENCIA_MINUTOS=15
