# Copia este archivo como .env y llena los valores.

# API de Django (PetroHelp)
DJANGO_API_URL=http://127.0.0.1:8000/api
# Usuario de Django con rol "operador" creado solo para el agente
DJANGO_AGENT_USER=agente_esp32
DJANGO_AGENT_PASSWORD=cambia-esta-contrasena
# (Opcional) en vez de usuario/contraseña, el token directo
DJANGO_AGENT_TOKEN=

# IA GRATIS con Ollama (modelo local en tu PC). Pon false para usar solo reglas.
IA_HABILITADA=true
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama

# id de categoría a usar si no se encuentra una adecuada (0 = la primera)
CATEGORIA_DEFAULT_ID=0

COOLDOWN_MINUTOS=30
SEGUNDOS_FUERA_DE_LINEA=120
